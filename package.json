{
  "name": "dsh-aftereffects",
  "version": "1.0.0",
  "description": "Drive Adobe After Effects from DeepSeek Harness: build compositions and motion-graphics templates, then render MP4 or PNG without leaving the chat.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./bridge": "./lib/bridge.js",
    "./templates": "./lib/templates.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "after-effects",
    "adobe",
    "extendscript",
    "motion-graphics",
    "video",
    "render",
    "mp4",
    "template",
    "animation",
    "aftereffects"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MokoKing666/dsh-aftereffects.git"
  },
  "homepage": "https://github.com/MokoKing666/dsh-aftereffects#readme",
  "bugs": {
    "url": "https://github.com/MokoKing666/dsh-aftereffects/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  }
}
