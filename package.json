{
  "name": "dsh-aftereffects",
  "version": "2.0.1",
  "description": "Commercial AE template toolkit: drive After Effects from DeepSeek Harness to build compositions, scan installed effects, inspect plugin parameters, capture previews, bind Essential Graphics controllers, mark audio beats, and snapshot projects before bulk edits.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./bridge": "./lib/bridge.js",
    "./templates": "./lib/templates.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/preview.svg",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "after-effects",
    "adobe",
    "extendscript",
    "motion-graphics",
    "video",
    "render",
    "mp4",
    "template",
    "animation",
    "aftereffects",
    "motion-graphics-template",
    "mogrt",
    "essential-graphics",
    "ffx",
    "effect-scan",
    "es3"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {},
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MokoKing666/dsh-aftereffects.git"
  },
  "homepage": "https://github.com/MokoKing666/dsh-aftereffects#readme",
  "bugs": {
    "url": "https://github.com/MokoKing666/dsh-aftereffects/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  }
}
